# Strata's own RDNA3 WMMA gemms declare their bf16 fragments as __bf16 vectors,
# which the amdgcn builtins (__builtin_amdgcn_wmma_f32_16x16x16_bf16_w32) want as
# short vectors: the three typedefs become short.  Bit-identical - the bytes reach
# the builtin only through a reinterpret_cast (wmma_gemm.cu) or a memcpy/bit-cast
# (kernels.cu, hb16/um_wmma read the fragments as uint4 words).
#
# Ported from PF4Public/gentoo-overlay sci-misc/strata files/strata-wmma-bf16.patch
# (Copyright 1999-2026 Gentoo Authors, GPL-2.0), regenerated against the v0.2.15
# sources on 2026-11-18 (its kernels.cu hunk sat 49 lines off; the line numbers
# here are v0.2.15's).  The ebuild applies it only while the buggy typedef is in
# the file, so an upstream fix turns it into a no-op.
--- a/src/prefill/wmma_gemm.cu	2026-11-18 01:17:02.308489543 +0700
+++ b/src/prefill/wmma_gemm.cu	2026-11-18 01:17:02.309103545 +0700
@@ -77,7 +77,7 @@
 
 template <>
 struct WmmaTraits<__bf16> {
-    using vec_t = __bf16 __attribute__((ext_vector_type(16)));
+    using vec_t = short __attribute__((ext_vector_type(16)));
     __device__ static inline v8fp32 mma(vec_t a, vec_t b, v8fp32 c) {
 #if defined(__gfx1100__) || defined(__gfx1101__) || defined(__gfx1102__) || defined(__gfx1103__) || defined(__gfx1150__) || defined(__gfx1151__)
         return __builtin_amdgcn_wmma_f32_16x16x16_bf16_w32(a, b, c);
@@ -486,7 +486,7 @@
 // so xn16 is read once.  128 x 128 blocks, the BK 64 single-buffer scheme of kernel_bk64.  s23/hcdown_probe.hip,
 // 16K tokens: 3.60 / 3.77 ms (hipBLASLt in the engine: down 6.78 + inject 1.81).  FP32 accumulation in another k
 // order than hipBLASLt: rounding-level.
-typedef __bf16 hb16 __attribute__((ext_vector_type(16)));
+typedef short hb16 __attribute__((ext_vector_type(16)));
 __device__ __forceinline__ hb16 bfrag(const uint16_t* p) {
     const uint4 a = *reinterpret_cast<const uint4*>(p), b = *reinterpret_cast<const uint4*>(p + 8);
     const uint32_t w[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
--- a/src/prefill/kernels.cu	2026-11-18 01:17:02.311426462 +0700
+++ b/src/prefill/kernels.cu	2026-11-18 01:17:02.312067232 +0700
@@ -2600,7 +2600,7 @@
 // mix (x_c = R * rs * w, sum of x_c * sigmoid(gated_c), / 4) runs in registers, in gr_mix_r_kernel's order.  The
 // GEMM sums K in another order than hipBLASLt: rounding-level, hence opt-in and quality-gated.
 #if defined(__HIPCC__)
-typedef __bf16 um_b16 __attribute__((ext_vector_type(16)));
+typedef short um_b16 __attribute__((ext_vector_type(16)));
 typedef float um_f8 __attribute__((ext_vector_type(8)));
 __device__ __forceinline__ um_f8 um_wmma(um_b16 a, um_b16 b, um_f8 c) {
 #if defined(__gfx1100__) || defined(__gfx1101__) || defined(__gfx1102__) || defined(__gfx1103__) || defined(__gfx1150__) || defined(__gfx1151__)
