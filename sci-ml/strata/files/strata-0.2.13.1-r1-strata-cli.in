#!/bin/sh
# Gentoo launcher for @WHAT@ (sci-ml/strata @PV@).
#
# Where Strata writes (upstream's layout, kept as it is): one per-user folder,
# $XDG_DATA_HOME/strata, holding components/ (engine packages), install/ (run
# configs, logs, third_party/) and the settings files.  Strata derives ALL of
# that folder from STRATA_COMPONENTS_DIR (<components>/../install is where the
# installer writes), so the read-only system store can never be announced
# through that variable: pointing it at @SYSCOMPS@ sends every write of Strata
# into /usr (PF4Public/gentoo-overlay#533, Niko1221/Strata#5591).
#
# So this launcher does the opposite: it links every engine package of the
# read-only @SYSCOMPS@ store into the user's OWN component store (the default
# place, or the STRATA_COMPONENTS_DIR the user chose themselves), and then
# hands over to the terminal.  Nothing else is exported.
set -u

if [ "$(id -u)" = 0 ] && [ "${STRATA_ALLOW_ROOT:-}" != 1 ]; then
	echo "@NAME@: refusing to run as root.  Strata writes per-user files, and a root run" >&2
	echo "@NAME@: leaves files your own user cannot open.  Run it as your own user" >&2
	echo "@NAME@: (STRATA_ALLOW_ROOT=1 overrides)." >&2
	exit 1
fi

syscomps="@SYSCOMPS@"
store="$syscomps/engine"

# A STRATA_COMPONENTS_DIR naming the read-only system store can only come from
# an old sci-misc/strata that exported it system-wide (/etc/env.d/90strata), and
# it survives in a session that predates that fix.  Strata's per-user default is
# used instead; log out and in again to clear the variable for good.
case ${STRATA_COMPONENTS_DIR:-} in
	"$syscomps"|"$syscomps"/)
		echo "@NAME@: ignoring STRATA_COMPONENTS_DIR=$STRATA_COMPONENTS_DIR (the read-only system store; log out and in again to clear it)" >&2
		unset STRATA_COMPONENTS_DIR
		;;
esac

components="${STRATA_COMPONENTS_DIR:-${XDG_DATA_HOME:-${HOME:?HOME is not set}/.local/share}/strata/components}"
engines="$components/engine"

if [ -d "$store" ]; then
	# a link this launcher made earlier for an engine folder the package no
	# longer ships (a revbump renames it only when the engine version changes)
	for link in "$engines"/*; do
		[ -L "$link" ] || continue
		case $(readlink "$link") in
			"$store"/*) [ -e "$link" ] || rm -f "$link" ;;
		esac
	done
	# every packaged engine, as a link in the user's store.  A real folder
	# there (an engine `strata update` installed) is never touched, and neither
	# is a folder that already exists: with both sci-misc/strata and
	# sci-ml/strata installed, whoever got there first keeps their copy.
	for pkg in "$store"/*/; do
		pkg=${pkg%/}
		[ -f "$pkg/engine-component.json" ] || continue
		dest="$engines/${pkg##*/}"
		if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
			mkdir -p "$engines" && ln -s "$pkg" "$dest" \
				|| echo "@NAME@: cannot link $pkg into $engines; Strata will not find the packaged engine" >&2
		fi
	done
fi

exec "@TARGET@" "$@"
